rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(farmId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/farms/$(farmId)) ||
        (
          exists(/databases/$(database)/documents/farms/$(farmId)) &&
          get(/databases/$(database)/documents/farms/$(farmId)).data.ownerUid == request.auth.uid
        )
      );
    }

    function getMember(farmId) {
      return get(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid)).data;
    }

    function isAdmin(farmId) {
      return isSignedIn() && (
        (
          exists(/databases/$(database)/documents/farms/$(farmId)) &&
          get(/databases/$(database)/documents/farms/$(farmId)).data.ownerUid == request.auth.uid
        ) ||
        (
          exists(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid)) &&
          getMember(farmId).permissionTier == 'admin'
        )
      );
    }

    function isProductionLead(farmId) {
      return isSignedIn() && isMember(farmId) && (
        isAdmin(farmId) ||
        (
          exists(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid)) &&
          getMember(farmId).roleLabel.matches('.*(?i)(production|lead).*')
        )
      );
    }

    function isQualityInspector(farmId) {
      return isSignedIn() && isMember(farmId) && (
        isAdmin(farmId) ||
        (
          exists(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid)) &&
          getMember(farmId).roleLabel.matches('.*(?i)(quality|inspector|qc|controller|qa).*')
        )
      );
    }

    function canMarkReadyRole(farmId) {
      return isSignedIn() && isMember(farmId) && (
        isAdmin(farmId) ||
        (
          exists(/databases/$(database)/documents/farms/$(farmId)/members/$(request.auth.uid)) &&
          getMember(farmId).roleLabel.matches('.*(?i)(quality|inspector|qc|controller|qa|production|lead).*')
        )
      );
    }

    // Reservation for unique business/farm display names
    match /farmNames/{normalizedFarmName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        !exists(/databases/$(database)/documents/farmNames/$(normalizedFarmName)) &&
        request.resource.data.reservedByUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.reservedByUid == request.auth.uid;
    }

    // User-bound facility index for resilient, direct querying
    match /users/{userId}/farms/{farmId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Collection group rule for finding user's own memberships across all facilities
    match /{path=**}/members/{memberUid} {
      allow read: if isSignedIn() && (
        request.auth.uid == memberUid ||
        resource.data.uid == request.auth.uid
      );
    }

    // Collection group rule for finding pending invites for the signed-in user
    match /{path=**}/invites/{inviteeEmail} {
      allow read: if isSignedIn() && (
        request.auth.token.email == inviteeEmail ||
        resource.data.email == request.auth.token.email
      );
    }

    // Farms collection
    match /farms/{farmId} {
      allow read: if isMember(farmId) || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin(farmId);
      allow delete: if isAdmin(farmId) && resource.data.ownerUid == request.auth.uid;

      // Farm Members subcollection
      match /members/{memberUid} {
        allow read: if isMember(farmId) || (isSignedIn() && request.auth.uid == memberUid);

        // Case 1: Farm creator self-registration as initial admin
        // Case 2: Email-gated invite acceptance with exact tier & role copied
        allow create: if isSignedIn() && request.auth.uid == memberUid && (
          (
            get(/databases/$(database)/documents/farms/$(farmId)).data.ownerUid == request.auth.uid &&
            request.resource.data.permissionTier == 'admin'
          ) || (
            request.auth.token.email != null &&
            exists(/databases/$(database)/documents/farms/$(farmId)/invites/$(request.auth.token.email)) &&
            request.resource.data.permissionTier == get(/databases/$(database)/documents/farms/$(farmId)/invites/$(request.auth.token.email)).data.permissionTier &&
            request.resource.data.roleLabel == get(/databases/$(database)/documents/farms/$(farmId)/invites/$(request.auth.token.email)).data.roleLabel
          )
        );

        allow update: if isAdmin(farmId);
        allow delete: if isAdmin(farmId) || (isSignedIn() && request.auth.uid == memberUid);
      }

      // Invites subcollection (docId is invitee email)
      match /invites/{inviteeEmail} {
        allow read: if isAdmin(farmId) || (isSignedIn() && (request.auth.token.email == inviteeEmail || resource.data.email == request.auth.token.email));
        allow create, update: if isAdmin(farmId) && request.resource.data.createdByUid == request.auth.uid;
        allow delete: if isAdmin(farmId) || (isSignedIn() && request.auth.token.email == inviteeEmail);
      }

      // Products catalog subcollection
      match /products/{productId} {
        allow read: if isMember(farmId);
        allow create: if isMember(farmId) && request.resource.data.createdByUid == request.auth.uid;
        allow update: if isMember(farmId);
        allow delete: if isAdmin(farmId);
      }

      // Raw Material Intake Logs (harvestLogs) subcollection
      match /harvestLogs/{logId} {
        // All facility members (Admins, Production Leads, Quality Controllers) can view intake records and batch lineage
        allow read: if isMember(farmId);
        // Raw Material entry is done by Production Lead and Admin; Quality Inspector and Production Lead can update (QC inspection / allocations)
        allow create: if isProductionLead(farmId) && request.resource.data.loggedByUid == request.auth.uid;
        allow update: if isProductionLead(farmId) || isQualityInspector(farmId);
        allow delete: if isAdmin(farmId);
      }

      // Production Batches subcollection
      match /batches/{batchId} {
        allow read: if isMember(farmId);
        // Admin and Production Lead can initiate new production batches
        allow create: if isProductionLead(farmId);

        // Workers can update progress readings and conditions
        // Admin, Quality Inspector, and Production Lead can mark status as 'ready'
        allow update: if isMember(farmId) && (
          isAdmin(farmId) ||
          (
            request.resource.data.status == 'ready' &&
            canMarkReadyRole(farmId)
          ) ||
          (
            request.resource.data.status == resource.data.status &&
            request.resource.data.status != 'ready' &&
            request.resource.data.status != 'packaged'
          )
        );
        allow delete: if isAdmin(farmId);

        // Multi-turn consultation messages under this batch
        match /messages/{messageId} {
          allow read: if isMember(farmId);
          allow create: if isMember(farmId) && request.resource.data.senderUid == request.auth.uid;
          allow update, delete: if isAdmin(farmId);
        }
      }

      // Packaging Logs (Grade A / Grade B packet storage)
      match /packagingLogs/{pkgId} {
        allow read: if isMember(farmId);
        allow create: if isMember(farmId) && request.resource.data.packedByUid == request.auth.uid;
        allow update: if isMember(farmId);
        allow delete: if isAdmin(farmId);
      }

      // Dispatching Orders & Records (Order source, destination, contact, payment status)
      match /dispatches/{dispatchId} {
        allow read: if isMember(farmId);
        allow create: if isMember(farmId) && request.resource.data.dispatchedByUid == request.auth.uid;
        allow update: if isMember(farmId);
        allow delete: if isAdmin(farmId);
      }
    }
  }
}
